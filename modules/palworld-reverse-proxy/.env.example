# Palworld Reverse Proxy Environment Variables
# Copy this file to .env and fill in your values

# Tailscale authentication key (get from https://login.tailscale.com/admin/settings/keys)
export TAILSCALE_AUTH_KEY="tskey-auth-xxxxx-xxxxxx"

# Palworld server IP (OPTIONAL - auto-discovered from Tailscale)
# The script will automatically find the machine with "homelab" in its name
# Only set this if you want to override auto-discovery or as a fallback
export PALWORLD_SERVER_IP="100.66.232.121"

# Admin CIDR blocks for SSH access (your public IP with /32)
# Get your IP: curl -s ifconfig.me
export ADMIN_CIDR_BLOCKS="YOUR.PUBLIC.IP/32"
